
Функция ЕстьПодчиненныеСчета(Элемент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Основной2014.Ссылка
	               |ИЗ
	               |	ПланСчетов.Основной2014 КАК Основной2014
	               |ГДЕ
	               |	Основной2014.Родитель = &Родитель";

	Запрос.УстановитьПараметр("Родитель", Элемент);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция ПолучитьОписаниеКатегории(НаименованиеКатегории)
	
	СтрокаВозврата = "";
	
	Найдено = КатегорииЗадолженности.Найти(НаименованиеКатегории);
	Если Найдено <> Неопределено Тогда
		Если Найдено.НомерСтроки = 1 Тогда
			Если Найдено.Просрочено = 0 Тогда
				СтрокаВозврата = Нстр("ru='Не просрочено';ro='Nu a expirat'");
			Иначе
				СтрокаВозврата = Нстр("ru='Просрочено';ro='Expirat'") + Символы.ВК + Нстр("ru='до ';ro='pina la'") + Найдено.Просрочено + Нстр("ru=' дн.';ro='zile'"); 
			КонецЕсли; 
		ИначеЕсли Найдено.НомерСтроки = КатегорииЗадолженности.Количество()  Тогда
			СтрокаВозврата = Нстр("ru='Просрочено';ro='Expirat'") + Символы.ВК + Нстр("ru=' более ';ro='mai mult'") + (Найдено.ПросроченоС - 1) + Нстр("ru=' дн.';ro='zile'"); 
		Иначе
			СтрокаВозврата = Нстр("ru='Просрочено';ro='Expirat'") + Символы.ВК + Нстр("ru=' от ';ro='din'") + Найдено.ПросроченоС + Нстр("ru=' до ';ro='pina la'") + Найдено.Просрочено + Нстр("ru=' дн.';ro='zile'"); 
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат СтрокаВозврата;
	
КонецФункции // ()


Функция Сформировать() Экспорт
	
	ТД = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	
	ДекомпозицияЗадолженности = Обработки.ДекомпозицияЗадолженности.Создать();
	ДекомпозицияЗадолженности.Период = КонецДня(Период);
	ДекомпозицияЗадолженности.Организация = Организация;
	ДекомпозицияЗадолженности.ВидЗадолженности = ВидЗадолженности;
	ДекомпозицияЗадолженности.Контрагент = Контрагент;
	ДекомпозицияЗадолженности.Счета.Загрузить(Счета.Выгрузить());
	ДекомпозицияЗадолженности.ТолькоДокументыРасчетов = Истина;
	
	ДекомпозицияЗадолженности.СрокОплатыВДнях = СрокОплатыВДнях;
	ДекомпозицияЗадолженности.УстановитьСрокОплатыВДнях = УстановитьСрокОплатыВДнях;
	
	ДекомпозицияЗадолженности.Заполнить();
	
	Для каждого ТекКатегория Из КатегорииЗадолженности Цикл
		
		Если ТекКатегория.НомерСтроки = 1 Тогда
			ТекКатегория.ПросроченоС = -999999999;
		Иначе
			ТекКатегория.ПросроченоС = КатегорииЗадолженности[ТекКатегория.НомерСтроки - 2].Просрочено + 1;
		КонецЕсли;
		ТекКатегория.Наименование = "_" + ТекКатегория.НомерСтроки;
		
	КонецЦикла;
	
	ТЗДЗ = ДекомпозицияЗадолженности.Задолженность.Выгрузить();
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ПараметрыСтроки = Новый КвалификаторыСтроки(250);
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов, , ПараметрыСтроки);
	
	ТЗДЗ.Колонки.Добавить("НаименованиеКонтрагента", ДопустимыеТипы);
	
	Для каждого ТекСтрока Из ТЗДЗ Цикл
		ТекСтрока.НаименованиеКонтрагента = ТекСтрока.Контрагент.Наименование;
	КонецЦикла; 
	ТЗКАТ = КатегорииЗадолженности.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗДЗ.Счет,
	|	ТЗДЗ.Контрагент,
	|	ТЗДЗ.Договор,
	|	ТЗДЗ.ДокументРасчетов,
	|	ТЗДЗ.Сумма,
	|	ТЗДЗ.ДатаВозникновения,
	|	ТЗДЗ.ВозрастДолга,
	|	ТЗДЗ.СрокОплаты,
	|	ТЗДЗ.Просрочено,
	|	ТЗДЗ.НаименованиеКонтрагента
	|ПОМЕСТИТЬ ТЗДЗ
	|ИЗ
	|	&ТЗДЗ КАК ТЗДЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗКАТ.Наименование,
	|	ТЗКАТ.Просрочено,
	|	ТЗКАТ.ПросроченоС
	|ПОМЕСТИТЬ ТЗКАТ
	|ИЗ
	|	&ТЗКАТ КАК ТЗКАТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗДЗ.Счет,
	|	ТЗДЗ.Контрагент КАК Контрагент,
	|	ТЗДЗ.Договор КАК Договор,
	|	ТЗДЗ.ДокументРасчетов КАК ДокументРасчетов,
	|	ТЗДЗ.Сумма КАК Сумма,
	|	ТЗДЗ.ДатаВозникновения КАК ДатаВозникновения,
	|	ТЗДЗ.ВозрастДолга,
	|	ТЗДЗ.СрокОплаты КАК СрокОплаты,
	|	ТЗДЗ.Просрочено,
	|	ТЗКАТ.Наименование КАК НаименованиеКатегории,
	|	ТЗКАТ.Просрочено КАК ПросроченоДо,
	|	ТЗКАТ.ПросроченоС,
	|	ВЫБОР
	|		КОГДА ТЗДЗ.Просрочено > 0
	|			ТОГДА ТЗДЗ.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаПросрочено
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	ТЗДЗ КАК ТЗДЗ
	|		ПОЛНОЕ СОЕДИНЕНИЕ ТЗКАТ КАК ТЗКАТ
	|		ПО ТЗДЗ.Просрочено >= ТЗКАТ.ПросроченоС
	|			И ТЗДЗ.Просрочено <= ТЗКАТ.Просрочено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗКАТ.Наименование КАК НаименованиеКатегории,
	|	ИтоговаяТаблица.Счет КАК Счет,
	|	ИтоговаяТаблица.Контрагент КАК Контрагент,
	|	ИтоговаяТаблица.Договор КАК Договор,
	|	ИтоговаяТаблица.Договор.СрокОплаты КАК СрокОплатыВДнях,
	|	ИтоговаяТаблица.ДокументРасчетов КАК ДокументРасчетов,
	|	ИтоговаяТаблица.Сумма КАК Сумма,
	|	ИтоговаяТаблица.ДатаВозникновения КАК ДатаВозникновения,
	|	ИтоговаяТаблица.ВозрастДолга,
	|	ИтоговаяТаблица.СрокОплаты КАК СрокОплаты,
	|	ВЫБОР КОГДА ИтоговаяТаблица.Просрочено < 0 ТОГДА 0 ИНАЧЕ ИтоговаяТаблица.Просрочено КОНЕЦ КАК Просрочено,
	|	ИтоговаяТаблица.ПросроченоДо,
	|	ИтоговаяТаблица.ПросроченоС,
	|	ИтоговаяТаблица.СуммаПросрочено КАК СуммаПросрочено,
	|	0 КАК Поле1
	|ИЗ
	|	ТЗКАТ КАК ТЗКАТ
	|		ПОЛНОЕ СОЕДИНЕНИЕ ИтоговаяТаблица КАК ИтоговаяТаблица
	|		ПО ТЗКАТ.Наименование = ИтоговаяТаблица.НаименованиеКатегории
	|ГДЕ
	|	Истина И 1 = 1
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счет.Код,
	|	Контрагент.Наименование,
	|	ДокументРасчетов.Дата,
	|	НаименованиеКатегории
	|ИТОГИ
	|	СУММА(Сумма),
	|	МИНИМУМ(ДатаВозникновения),
	|	МИНИМУМ(СрокОплаты),
	|	МИНИМУМ(СрокОплатыВДнях),
	|	МАКСИМУМ(Просрочено),
	|	МАКСИМУМ(ВозрастДолга),
	|	СУММА(СуммаПросрочено)
	|ПО
	|	ОБЩИЕ, Счет ИЕРАРХИЯ,
	|	НаименованиеКатегории,
	|	Контрагент,
	|	Договор,
	|	ДокументРасчетов
	|";
	
	Запрос.УстановитьПараметр("ТЗДЗ", ТЗДЗ);			   
	Запрос.УстановитьПараметр("ТЗКАТ", ТЗКАТ);			   
	Запрос.УстановитьПараметр("СрокОплатыВДнях", СрокОплатыВДнях);
	
	Если ВидЗадолженности = "Кредиторская" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СуммаОстатокДт", "СуммаОстатокКт");	
	КонецЕсли;
	
	Если УстановитьСрокОплатыВДнях Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИтоговаяТаблица.Договор.СрокОплаты", "&СрокОплатыВДнях")
	КонецЕсли; 
	
	Если НЕ РазворачиватьПоСчетам Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИтоговаяТаблица.Счет КАК Счет", "&Счет00 КАК Счет");	
		Запрос.УстановитьПараметр("Счет00", ПланыСчетов.Основной2014.Счет00);			   
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " И 1 = 1", " И ИтоговаяТаблица.Договор В ИЕРАРХИИ (&Договор)");
		Запрос.УстановитьПараметр("Договор", Договор);			   
	КонецЕсли; 
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Рез = РезультатЗапроса[3];
	
	РазворачиватьПоКатегориямЗадолженности = КатегорииЗадолженности.Количество() > 0 И РазворачиватьПоПериодам;
	
	ОбластьНачало = Макет.ПолучитьОбласть("Шапка|Начало");
	ОбластьНачало.Параметры.Дата = Формат(Период, "ДФ=dd.MM.yyyy");
	ОбластьНачало.Параметры.Организация = Организация;
	ОбластьНачало.Параметры.Отборы = Нстр("ru='Контрагент: ';ro='Agent economic:'") + ?(ЗначениеЗаполнено(Контрагент), Контрагент, Нстр("ru='по всем ';ro='pe toti'")) + Символы.ВК + Нстр("ru='Договор: ';ro='Contract:'") + ?(ЗначениеЗаполнено(Договор), Договор, Нстр("ru='по всем ';ro='pe toti'"));
	ТД.Вывести(ОбластьНачало);
	
	Если РазворачиватьПоКатегориямЗадолженности Тогда
		
		ВыборкаКатегории = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НаименованиеКатегории", "Все");
		НН = 0;
		Пока ВыборкаКатегории.Следующий() Цикл
			НН = НН + 1;
			
			ОбластьКатегория = Макет.ПолучитьОбласть("Шапка|Категория");
			ОбластьКатегория.Параметры.Категория = НН;
			ОбластьКатегория.Параметры.Интервал = ПолучитьОписаниеКатегории(ВыборкаКатегории.НаименованиеКатегории);
			
			ТД.Присоединить(ОбластьКатегория);
		КонецЦикла; 
		
		//ОбластьКонец = Макет.ПолучитьОбласть("Шапка|Конец");
		//ТД.Присоединить(ОбластьКонец);
		
	КонецЕсли; 
	
	ТД.НачатьАвтогруппировкуСтрок();
	
	УровеньГруппировкиСчета = 0;
	ВыборкаСчета = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Счет");
	Пока ВыборкаСчета.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаСчета.Счет) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если РазворачиватьПоСчетам Тогда
			
			ЕстьПодчиненныеЭлементы = ЕстьПодчиненныеСчета(ВыборкаСчета.Счет);
			
			ОбластьНачало = Макет.ПолучитьОбласть("Счет" + ?(ЕстьПодчиненныеЭлементы, "Группа", "") + "|Начало");
			ОбластьНачало.Параметры.Заполнить(ВыборкаСчета);
			
			ТД.Вывести(ОбластьНачало, УровеньГруппировкиСчета + ВыборкаСчета.Счет.Уровень());
			
			Если РазворачиватьПоКатегориямЗадолженности Тогда
				
				ВыборкаКатегории = ВыборкаСчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НаименованиеКатегории", "Все");
				Пока ВыборкаКатегории.Следующий() Цикл
					
					ОбластьКатегория = Макет.ПолучитьОбласть("Счет" + ?(ЕстьПодчиненныеЭлементы, "Группа", "") + "|Категория");
					ОбластьКатегория.Параметры.Заполнить(ВыборкаКатегории);
					ТД.Присоединить(ОбластьКатегория);
					
				КонецЦикла; 
				
				//ОбластьКонец = Макет.ПолучитьОбласть("Счет" + ?(ЕстьПодчиненныеЭлементы, "Группа", "") + "|Конец");
				//ОбластьКонец.Параметры.Заполнить(ВыборкаСчета);
				//ТД.Присоединить(ОбластьКонец);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		УровеньГруппировкиКонтрагенты = УровеньГруппировкиСчета + ВыборкаСчета.Счет.Уровень() + 1;
		
		ВыборкаКонтрагенты = ВыборкаСчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Контрагент");
		
		Пока ВыборкаКонтрагенты.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(ВыборкаКонтрагенты.Контрагент) Тогда
				Продолжить;
			КонецЕсли; 
			
			ОбластьНачало = Макет.ПолучитьОбласть("Контрагент|Начало");
			ОбластьНачало.Параметры.Заполнить(ВыборкаКонтрагенты);
			
			ТД.Вывести(ОбластьНачало, УровеньГруппировкиКонтрагенты);
			
			Если РазворачиватьПоКатегориямЗадолженности Тогда
				
				ВыборкаКатегории = ВыборкаКонтрагенты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НаименованиеКатегории", "Все");
				Пока ВыборкаКатегории.Следующий() Цикл
					
					ОбластьКатегория = Макет.ПолучитьОбласть("Контрагент|Категория");
					ОбластьКатегория.Параметры.Заполнить(ВыборкаКатегории);
					ТД.Присоединить(ОбластьКатегория);
					
				КонецЦикла; 
				
				//ОбластьКонец = Макет.ПолучитьОбласть("Контрагент|Конец");
				//ОбластьКонец.Параметры.Заполнить(ВыборкаКонтрагенты);
				//ТД.Присоединить(ОбластьКонец);
				
			КонецЕсли; 
			
			УровеньГруппировкиДоговоры = УровеньГруппировкиКонтрагенты + 1; 
			
			Если РазворачиватьПоДоговорам Тогда
				
				ВыборкаДоговоры = ВыборкаКонтрагенты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Договор");
				Пока ВыборкаДоговоры.Следующий() Цикл
					
					ОбластьНачало = Макет.ПолучитьОбласть("Договор|Начало");
					ОбластьНачало.Параметры.Заполнить(ВыборкаДоговоры);
					
					ТД.Вывести(ОбластьНачало, УровеньГруппировкиДоговоры);
					
					Если РазворачиватьПоКатегориямЗадолженности Тогда
						
						ВыборкаКатегории = ВыборкаДоговоры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НаименованиеКатегории", "Все");
						Пока ВыборкаКатегории.Следующий() Цикл
							
							ОбластьКатегория = Макет.ПолучитьОбласть("Договор|Категория");
							ОбластьКатегория.Параметры.Заполнить(ВыборкаКатегории);
							ТД.Присоединить(ОбластьКатегория);
							
						КонецЦикла; 
						
						//ОбластьКонец = Макет.ПолучитьОбласть("Договор|Конец");
						//ОбластьКонец.Параметры.Заполнить(ВыборкаДоговоры);
						//ТД.Присоединить(ОбластьКонец);
						
					КонецЕсли; 
					
					УровеньГруппировкиДокументы = УровеньГруппировкиДоговоры + 1;
					Если РазворачиватьПоДокументам Тогда
						
						ВыборкаДокументы = ВыборкаДоговоры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ДокументРасчетов");
						Пока ВыборкаДокументы.Следующий() Цикл
							
							ОбластьНачало = Макет.ПолучитьОбласть("Документ|Начало");
							ОбластьНачало.Параметры.Заполнить(ВыборкаДокументы);
							ОбластьНачало.Параметры.ДокументРасчетовПредставление = ПолучитьПредставлениеДокументаРасчетов(ВыборкаДокументы.ДокументРасчетов);
							ОбластьНачало.Параметры.ДокументРасчетов = ВыборкаДокументы.ДокументРасчетов;
							ТД.Вывести(ОбластьНачало, УровеньГруппировкиДокументы);
							
							Если РазворачиватьПоКатегориямЗадолженности Тогда
								
								ВыборкаКатегории = ВыборкаДокументы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НаименованиеКатегории", "Все");
								
								Пока ВыборкаКатегории.Следующий() Цикл
									
									ОбластьКатегория = Макет.ПолучитьОбласть("Документ|Категория");
									ОбластьКатегория.Параметры.Заполнить(ВыборкаКатегории);
									ТД.Присоединить(ОбластьКатегория);
									
								КонецЦикла; 
								
								//ОбластьКонец = Макет.ПолучитьОбласть("Документ|Конец");
								//ОбластьКонец.Параметры.Заполнить(ВыборкаДокументы);
								//ТД.Присоединить(ОбластьКонец);
								
							КонецЕсли; 
							
						КонецЦикла; 
						
					КонецЕсли; 
					
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТД.ЗакончитьАвтогруппировкуСтрок();
	
	ОбластьНачало = Макет.ПолучитьОбласть("Подвал|Начало");
	ВыборкаПодвал = Рез.Выбрать(ОбходРезультатаЗапроса.Прямой);
	ВыборкаПодвал.Следующий();
	
	ОбластьНачало.Параметры.Заполнить(ВыборкаПодвал);
	ТД.Вывести(ОбластьНачало);
	
	Если РазворачиватьПоКатегориямЗадолженности Тогда
		
		ВыборкаКатегории = Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НаименованиеКатегории", "Все");
		Пока ВыборкаКатегории.Следующий() Цикл
			
			ОбластьКатегория = Макет.ПолучитьОбласть("Подвал|Категория");
			ОбластьКатегория.Параметры.Заполнить(ВыборкаКатегории);
			ТД.Присоединить(ОбластьКатегория);
			
		КонецЦикла; 
		
		//ОбластьКонец = Макет.ПолучитьОбласть("Подвал|Конец");
		//ОбластьКонец.Параметры.Заполнить(ВыборкаПодвал);
		//ТД.Присоединить(ОбластьКонец);
		
	КонецЕсли; 
	
	Возврат ТД;
	
КонецФункции

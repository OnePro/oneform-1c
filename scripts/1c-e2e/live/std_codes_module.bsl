// Std-codes launcher. Parameter: "<mode>|<out>|<form>"
//   cfg:<Вид>.<Имя>|out|<Форма>   one config object form (Вид = Справочники, Документы, ...)
//   batch:<listfile>|out|-        listfile lines: <Вид>.<Имя>|<Форма>[|<ИмяГлавногоРеквизита>]  (3rd: prints '@root|имя|ТипЗнч(Ф.имя)')
// Output: "## <Вид>.<Имя>|<Форма>" then "Имя|Данные" per control, "Имя.Колонка|Данные" per table column.
Перем Т;
Перем ПутьВыхода;

Функция Разд(Знач Стр, Р)
	М = Новый Массив;
	Пока Истина Цикл
		П = Найти(Стр, Р);
		Если П = 0 Тогда
			М.Добавить(Стр);
			Прервать;
		КонецЕсли;
		М.Добавить(Лев(Стр, П - 1));
		Стр = Сред(Стр, П + СтрДлина(Р));
	КонецЦикла;
	Возврат М;
КонецФункции

Функция Данные(Эл)
	Попытка
		З = Эл.Данные;
		Возврат Строка(З);
	Исключение
		Возврат "<нет>";
	КонецПопытки;
КонецФункции

Функция Создатель(Вид)
	Если Вид = "Справочники" Или Вид = "ПланыВидовХарактеристик" Тогда
		Возврат "СоздатьЭлемент";
	ИначеЕсли Вид = "Документы" Тогда
		Возврат "СоздатьДокумент";
	ИначеЕсли Вид = "ПланыСчетов" Тогда
		Возврат "СоздатьСчет";
	ИначеЕсли Вид = "ПланыОбмена" Тогда
		Возврат "СоздатьУзел";
	ИначеЕсли Вид = "ПланыВидовРасчета" Тогда
		Возврат "СоздатьВидРасчета";
	ИначеЕсли Вид = "РегистрыСведений" Тогда
		Возврат "СоздатьМенеджерЗаписи";
	ИначеЕсли Вид = "Задачи" Тогда
		Возврат "СоздатьЗадачу";
	ИначеЕсли Вид = "БизнесПроцессы" Тогда
		Возврат "СоздатьБизнесПроцесс";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьФормуОбъекта(Вид, Имя, ИмяФормы, Ошибка)
	Ошибка = "";
	Попытка
		Мнг = Вычислить(Вид);
		Эл = Мнг[Имя];
	Исключение
		Ошибка = "нет объекта: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;
	Попытка
		Если ИмяФормы = "default" Тогда
			Возврат Эл.ПолучитьФорму();
		КонецЕсли;
		Возврат Эл.ПолучитьФорму(ИмяФормы);
	Исключение
		Ошибка = "ПолучитьФорму: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Сз = Создатель(Вид);
	Если Сз <> "" Тогда
		Попытка
			Об = Вычислить("Эл." + Сз + "()");
			Возврат Об.ПолучитьФорму(ИмяФормы);
		Исключение
			Ошибка = Ошибка + " | " + Сз + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура КореньФормы(Ф, Знач ИмяРеквизита)
	Если ИмяРеквизита = "" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Т.ДобавитьСтроку("@root|" + ИмяРеквизита + "|" + Строка(ТипЗнч(Вычислить("Ф." + ИмяРеквизита))));
	Исключение
		Т.ДобавитьСтроку("@root|" + ИмяРеквизита + "|<нет>");
	КонецПопытки;
КонецПроцедуры

Процедура ДампФормы(Ф)
	Для Каждого Эл Из Ф.ЭлементыФормы Цикл
		Попытка
			Т.ДобавитьСтроку(Эл.Имя + "|" + Данные(Эл));
			Попытка
				Для Каждого К Из Эл.Колонки Цикл
					Т.ДобавитьСтроку(Эл.Имя + "." + К.Имя + "|" + Данные(К));
				КонецЦикла;
			Исключение
			КонецПопытки;
		Исключение
			Т.ДобавитьСтроку("<ошибка>|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура Запись()
	Для Н = 1 По 2000 Цикл
		Попытка
			Т.Записать(ПутьВыхода, КодировкаТекста.UTF8);
			Возврат;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура Один(Знач Спец, Знач ИмяФормы, Знач Корень = "")
	П = Найти(Спец, ".");
	Вид = Лев(Спец, П - 1);
	Имя = Сред(Спец, П + 1);
	Т.ДобавитьСтроку("## " + Спец + "|" + ИмяФормы);
	Запись();
	Ошибка = "";
	Ф = ПолучитьФормуОбъекта(Вид, Имя, ИмяФормы, Ошибка);
	Если Ф = Неопределено Тогда
		Т.ДобавитьСтроку("<ОШИБКА>|" + Ошибка);
	Иначе
		КореньФормы(Ф, Корень);
		ДампФормы(Ф);
		Попытка
			Ф.Закрыть();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Запись();
КонецПроцедуры

Процедура ПриОткрытии()
	М = Разд(ПараметрЗапуска, "|");
	ПутьВыхода = М[1];
	Т = Новый ТекстовыйДокумент;
	Попытка
		Если Лев(М[0], 4) = "cfg:" Тогда
			Один(Сред(М[0], 5), М[2]);
		ИначеЕсли Лев(М[0], 6) = "batch:" Тогда
			Список = Новый ТекстовыйДокумент;
			Список.Прочитать(Сред(М[0], 7), КодировкаТекста.UTF8);
			Для Н = 1 По Список.КоличествоСтрок() Цикл
				Стр = СокрЛП(Список.ПолучитьСтроку(Н));
				Если Стр = "" Тогда
					Продолжить;
				КонецЕсли;
				Ч = Разд(Стр, "|");
				Один(Ч[0], Ч[1], ?(Ч.Количество() > 2, Ч[2], ""));
			КонецЦикла;
		КонецЕсли;
		Т.ДобавитьСтроку("## END");
	Исключение
		Т.ДобавитьСтроку("LAUNCH-ERROR: " + ОписаниеОшибки());
	КонецПопытки;
	Запись();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

Процедура КнопкаЗаписатьНажатие(Элемент)
КонецПроцедуры

Процедура КнопкаПроверитьИНННажатие(Элемент)
КонецПроцедуры

Процедура КнопкаЗакрытьНажатие(Элемент)
КонецПроцедуры

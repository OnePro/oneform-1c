// Introspection dump launcher: loads a target EPF, gets its form, writes every control's properties to a file.
Перем Т;
Перем Ф;
Перем ПутьВыхода;

Функция Разд(Знач Стр, Р)
	М = Новый Массив;
	Пока Истина Цикл
		П = Найти(Стр, Р);
		Если П = 0 Тогда
			М.Добавить(Стр);
			Прервать;
		КонецЕсли;
		М.Добавить(Лев(Стр, П - 1));
		Стр = Сред(Стр, П + СтрДлина(Р));
	КонецЦикла;
	Возврат М;
КонецФункции

Функция ЗнСтр(З)
	Попытка
		Возврат Строка(ТипЗнч(З)) + "|" + Строка(З);
	Исключение
		Возврат Строка(ТипЗнч(З)) + "|?";
	КонецПопытки;
КонецФункции

Процедура Св(Пр, Об, Имя)
	Попытка
		З = Вычислить("Об." + Имя);
		Т.ДобавитьСтроку(Пр + "." + Имя + "=" + ЗнСтр(З));
	Исключение
		Т.ДобавитьСтроку(Пр + "." + Имя + "=<нет>");
	КонецПопытки;
КонецПроцедуры

Процедура ДампКнопок(Пр, Кнопки)
	Для Каждого Кн Из Кнопки Цикл
		КП = Пр + "." + Кн.Имя;
		Для Каждого Нм Из Разд("Текст,Подсказка,Видимость,Доступность,Пометка,ТипКнопки,Отображение,Положение", ",") Цикл
			Св(КП, Кн, Нм);
		КонецЦикла;
		Попытка
			Т.ДобавитьСтроку(КП + ".Действие=" + Строка(Кн.Действие));
		Исключение
		КонецПопытки;
		Попытка
			Если Кн.Кнопки.Количество() > 0 Тогда
				ДампКнопок(КП, Кн.Кнопки);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ДампЭл(Эл, Фаза)
	П = Фаза + ":" + Эл.Имя;
	Т.ДобавитьСтроку(П + "=" + Строка(ТипЗнч(Эл)));
	Для Каждого Нм Из Разд("Лево,Верх,Ширина,Высота,Видимость,Доступность,ТолькоПросмотр,Заголовок,Данные,Значение,ПорядокОбхода,ТекущаяСтраница,ТекущаяКолонка,Подсказка,ЦветТекста,ЦветФона,ЦветРамки,Шрифт,ИерархическийПросмотр,ВыборГруппИЭлементов,АвтоОбновление,КнопкаВыбора,КнопкаОчистки,КнопкаОткрытия,Маска,Формат,ГоризонтальноеПоложение,ПоложениеЗаголовка,РежимВыбора,ТипЗначения,ПоказыватьЗаголовки,ГоризонтальнаяПолосаПрокрутки,ОтображениеЗакладок,Страницы.Количество(),РаспределятьПоСтраницам,АвтоПорядокОбхода,РежимПрокручиваемыхСтраниц,Свертка,ТекущаяСтраница.Имя", ",") Цикл
		Св(П, Эл, Нм);
	КонецЦикла;
	Для Каждого Г Из Разд("Лево,Верх,Право,Низ", ",") Цикл
		Попытка
			Т.ДобавитьСтроку(П + ".Привязка." + Г + "=" + Строка(Эл.ПолучитьПривязку(ГраницаЭлементаУправления[Г])));
		Исключение
		КонецПопытки;
	КонецЦикла;
	Попытка
		Для Каждого К Из Эл.Колонки Цикл
			КП = П + ".Кол." + К.Имя;
			Для Каждого Нм Из Разд("Данные,ТекстШапки,ТекстПодвала,Ширина,Видимость,ТолькоПросмотр,ГоризонтальноеПоложение,Формат,ЦветТекста,ЦветФона,Подсказка,ПорядокОбхода", ",") Цикл
				Св(КП, К, Нм);
			КонецЦикла;
			Попытка
				Т.ДобавитьСтроку(КП + ".Редактор=" + Строка(ТипЗнч(К.ЭлементУправления)));
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Попытка
		Для Каждого С Из Эл.Страницы Цикл
			Т.ДобавитьСтроку(П + ".Стр." + С.Имя + "=" + С.Заголовок + "|" + Строка(С.Видимость) + "|" + Строка(С.Доступность));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Попытка
		ДампКнопок(П + ".Кн", Эл.Кнопки);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура ДампФормы(Фаза)
	Для Каждого Эл Из Ф.ЭлементыФормы Цикл
		Попытка
			ДампЭл(Эл, Фаза);
		Исключение
			Т.ДобавитьСтроку(Фаза + ":" + Эл.Имя + "=<ошибка дампа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ">");
		КонецПопытки;
	КонецЦикла;
	Для Каждого Нм Из Разд("Заголовок,Ширина,Высота", ",") Цикл
		Св(Фаза + ":ФОРМА", Ф, Нм);
	КонецЦикла;
КонецПроцедуры

Функция Значения(Спец)
	Р = Новый Структура;
	Если Спец = "" Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Ч Из Разд(Спец, ";") Цикл
		П = Найти(Ч, "=");
		Имя = Лев(Ч, П - 1);
		З = Сред(Ч, П + 1);
		Тип = Лев(З, 2);
		З = Сред(З, 3);
		Если Тип = "n:" Тогда
			Р.Вставить(Имя, Число(З));
		ИначеЕсли Тип = "b:" Тогда
			Р.Вставить(Имя, З = "1");
		Иначе
			Р.Вставить(Имя, З);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура Заполнить(Об, Р)
	Для Каждого КЗ Из Р Цикл
		Выполнить("Об." + КЗ.Ключ + " = КЗ.Значение");
	КонецЦикла;
КонецПроцедуры

Функция Объект(Вид, Имя, Режим, Значения)
	Мнг = Вычислить(Вид + "." + Имя);
	Если Вид = "Документы" Тогда
		Сз = "СоздатьДокумент";
	Иначе
		Сз = "СоздатьЭлемент";
	КонецЕсли;
	Выб = Мнг.Выбрать();
	Первый = Неопределено;
	Н = 0;
	Пока Выб.Следующий() Цикл
		Н = Н + 1;
		Если Первый = Неопределено Тогда
			Первый = Выб.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Т.ДобавитьСтроку("@count|" + Н);
	Если Режим = "new" Тогда
		Возврат Вычислить("Мнг." + Сз + "()");
	КонецЕсли;
	Если Первый = Неопределено Тогда
		Об = Вычислить("Мнг." + Сз + "()");
		Если Вид = "Документы" Тогда
			Об.Дата = ТекущаяДата();
		Иначе
			Об.Наименование = "Проверка привязки";
		КонецЕсли;
		Заполнить(Об, Значения);
		Об.Записать();
		Т.ДобавитьСтроку("@seeded|" + Строка(Об.Ссылка));
		Возврат Об;
	КонецЕсли;
	Об = Первый.ПолучитьОбъект();
	Если Значения.Количество() > 0 Тогда
		Заполнить(Об, Значения);
		Об.Записать();
		Т.ДобавитьСтроку("@updated|" + Строка(Об.Ссылка));
	КонецЕсли;
	Возврат Об;
КонецФункции

Процедура Завершить() Экспорт
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

Процедура Писать()
	Т.Записать(ПутьВыхода, КодировкаТекста.UTF8);
КонецПроцедуры

Процедура ПриОткрытии()
	М = Разд(ПараметрЗапуска, "|");
	ПутьВыхода = М[1];
	Т = Новый ТекстовыйДокумент;
	Попытка
		Спец = М[0];
		П = Найти(Спец, ".");
		Вид = Лев(Спец, П - 1);
		Имя = Сред(Спец, П + 1);
		ИмяФормы = М[2];
		Режим = М[3];
		ЗнСп = ?(М.Количество() > 4, М[4], "");
		Если Вид = "ВнешнийОтчет" Или Вид = "ВнешняяОбработка" Тогда
			// Внешний файл: спецификация «ВнешнийОтчет.<путь к .erf>» / «ВнешняяОбработка.<путь к .epf>»
			Если Вид = "ВнешнийОтчет" Тогда
				Об = ВнешниеОтчеты.Создать(Имя, Ложь);
			Иначе
				Об = ВнешниеОбработки.Создать(Имя, Ложь);
			КонецЕсли;
		Иначе
			Об = Объект(Вид, Имя, Режим, Значения(ЗнСп));
		КонецЕсли;
		Т.ДобавитьСтроку("@object|" + Строка(Об));
		Ф = Об.ПолучитьФорму(ИмяФормы);
		Если М.Количество() > 5 И М[5] <> "" Тогда
			// «Панель.Страница»: сделать страницу текущей до дампа (какие элементы на какой странице видно по снимку)
			ПС = Разд(М[5], ".");
			Ф.ЭлементыФормы[ПС[0]].ТекущаяСтраница = Ф.ЭлементыФормы[ПС[0]].Страницы[ПС[1]];
		КонецЕсли;
		ДампФормы("pre");
	Исключение
		Т.ДобавитьСтроку("LAUNCH-ERROR: " + ОписаниеОшибки());
		Писать();
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецПопытки;
	ПодключитьОбработчикОжидания("Показ", 4, Истина);
КонецПроцедуры

Процедура Показ() Экспорт
	Попытка
		ДампФормы("post");
		Т.ДобавитьСтроку("## READY");
		Писать();
		ПодключитьОбработчикОжидания("Завершить", 45, Истина);
		Ф.ОткрытьМодально();
	Исключение
		Т.ДобавитьСтроку("LAUNCH-ERROR: " + ОписаниеОшибки());
		Писать();
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецПопытки;
КонецПроцедуры

Процедура КнопкаЗаписатьНажатие(Элемент)
КонецПроцедуры

Процедура КнопкаПроверитьИНННажатие(Элемент)
КонецПроцедуры

Процедура КнопкаЗакрытьНажатие(Элемент)
КонецПроцедуры
